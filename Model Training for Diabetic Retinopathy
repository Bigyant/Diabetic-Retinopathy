# =========================================================
# FIXED EFFICIENTNETB7 TRAINING PIPELINE
# FOR DIABETIC RETINOPATHY CLASSIFICATION
#
# FIXES APPLIED:
# [1] NO oversampling before splitting — zero data leakage
# [2] Proper 3-way split: Train / Validation / Test
#     - Test set is locked away until final evaluation
# [3] Oversampling (RandomOverSampler) applied ONLY on
#     training fold indices, never touching val or test
# [4] Class weights removed — oversampling handles imbalance
# [5] Full RGB preserved — red/blue channels carry critical
#     DR lesion color information for EfficientNet
# [6] K-Fold is now actually used for train/val tuning
# [7] Final accuracy reported on the held-out test set
# =========================================================


# =========================================================
# WARNING SUPPRESSION
# =========================================================
import os
os.environ["TF_CPP_MIN_LOG_LEVEL"] = "3"
os.environ["TF_ENABLE_ONEDNN_OPTS"] = "0"
os.environ["CUDA_VISIBLE_DEVICES"] = "0"

import warnings
warnings.filterwarnings("ignore")


# =========================================================
# IMPORTS
# =========================================================
import gc
gc.collect()

import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import tensorflow as tf

from sklearn.model_selection import train_test_split, StratifiedKFold
from sklearn.metrics import classification_report, confusion_matrix

# FIX [3]: Use RandomOverSampler — applied AFTER splitting,
# only on training data, so val/test stay clean
from imblearn.over_sampling import RandomOverSampler

from tensorflow.keras import layers
from tensorflow.keras.models import Model
from tensorflow.keras.callbacks import ModelCheckpoint, EarlyStopping
from tensorflow.keras.applications import EfficientNetB7
from tensorflow.keras.applications.efficientnet import preprocess_input


# =========================================================
# GPU MEMORY GROWTH
# =========================================================
gpus = tf.config.list_physical_devices('GPU')
if gpus:
    try:
        for gpu in gpus:
            tf.config.experimental.set_memory_growth(gpu, True)
        print("GPU Enabled Successfully")
    except RuntimeError as e:
        print(e)


# =========================================================
# MIXED PRECISION
# =========================================================
tf.keras.mixed_precision.set_global_policy('mixed_float16')


# =========================================================
# CONFIG
# =========================================================
IMG_SIZE    = 380
BATCH_SIZE  = 8
NUM_CLASSES = 5
HEAD_EPOCHS = 15
FINE_TUNE_EPOCHS = 45
SEED        = 42


# =========================================================
# LOAD ARRAYS
# FIX [5]: Load the ORIGINAL non-duplicated, full-RGB
# arrays that were saved BEFORE any oversampling.
# Your X.npy must be shape (N, 380, 380, 3) with all
# 3 colour channels intact. If you previously saved a
# single-channel (green-only) array, re-export from
# your raw images keeping all RGB channels.
# =========================================================
print("\nLoading Arrays...\n")
X = np.load("X.npy")   # shape: (N, IMG_SIZE, IMG_SIZE, 3)
y = np.load("y.npy")   # shape: (N,)  integer labels 0-4

print("X Shape:", X.shape)
print("y Shape:", y.shape)

assert X.ndim == 4 and X.shape[-1] == 3, (
    "X must be (N, H, W, 3). "
    "Re-export your images keeping all RGB channels."
)


# =========================================================
# FIX [2]: LOCK AWAY TEST SET FIRST — before anything else
#
# 70 % train+val  |  15 % validation  |  15 % test
# The test set is never touched during training or tuning.
# =========================================================
X_trainval, X_test, y_trainval, y_test = train_test_split(
    X, y,
    test_size=0.15,
    stratify=y,
    random_state=SEED
)

X_train_base, X_val, y_train_base, y_val = train_test_split(
    X_trainval, y_trainval,
    test_size=(0.15 / 0.85),   # keeps overall ratio 70/15/15
    stratify=y_trainval,
    random_state=SEED
)

print(f"\nSplit sizes — "
      f"Train: {len(X_train_base)}, "
      f"Val: {len(X_val)}, "
      f"Test: {len(X_test)}")


# =========================================================
# FIX [3]: OVERSAMPLE TRAINING SET ONLY
#
# RandomOverSampler duplicates minority-class samples by
# randomly repeating existing ones — but this is fine here
# because duplicates are confined entirely to the training
# set. The validation and test sets are untouched, so
# there is zero leakage.
# =========================================================
print("\nApplying oversampling on training set only...\n")

N, H, W, C = X_train_base.shape
X_flat = X_train_base.reshape(N, -1)          # flatten for ROS

ros = RandomOverSampler(random_state=SEED)
X_flat_res, y_train = ros.fit_resample(X_flat, y_train_base)

X_train = X_flat_res.reshape(-1, H, W, C)    # restore shape

print(f"Training set after oversampling: {X_train.shape[0]} samples")
print("Class distribution:", dict(zip(*np.unique(y_train, return_counts=True))))


# =========================================================
# FIX [5]: PREPROCESS INPUT (full RGB)
# EfficientNet's preprocess_input expects BGR values in
# [0,255] or normalises internally — pass float32 RGB as-is
# =========================================================
X_train = preprocess_input(X_train.astype(np.float32))
X_val   = preprocess_input(X_val.astype(np.float32))
X_test  = preprocess_input(X_test.astype(np.float32))


# =========================================================
# TF DATASET PIPELINES
# =========================================================
AUTOTUNE = tf.data.AUTOTUNE

train_ds = (
    tf.data.Dataset.from_tensor_slices((X_train, y_train))
    .shuffle(2048)
    .batch(BATCH_SIZE)
    .prefetch(AUTOTUNE)
)

val_ds = (
    tf.data.Dataset.from_tensor_slices((X_val, y_val))
    .batch(BATCH_SIZE)
    .prefetch(AUTOTUNE)
)

# Test dataset — batched but NOT shuffled
test_ds = (
    tf.data.Dataset.from_tensor_slices((X_test, y_test))
    .batch(BATCH_SIZE)
    .prefetch(AUTOTUNE)
)


# =========================================================
# AUGMENTATION (applied inside model, training-time only)
# =========================================================
data_augmentation = tf.keras.Sequential([
    layers.RandomFlip("horizontal"),
    layers.RandomRotation(0.03),
    layers.RandomZoom(0.05),
    layers.RandomTranslation(height_factor=0.02, width_factor=0.02),
    layers.RandomContrast(0.05),
])


# =========================================================
# FOCAL LOSS
# =========================================================
class FocalLoss(tf.keras.losses.Loss):

    def __init__(self, gamma=2.0, label_smoothing=0.05):
        super().__init__()
        self.gamma = gamma
        self.label_smoothing = label_smoothing

    def call(self, y_true, y_pred):
        y_true = tf.one_hot(tf.cast(y_true, tf.int32), depth=NUM_CLASSES)
        y_true = (y_true * (1 - self.label_smoothing)
                  + self.label_smoothing / NUM_CLASSES)

        ce = tf.keras.losses.categorical_crossentropy(y_true, y_pred)
        p_t = tf.exp(-ce)
        focal_loss = ((1 - p_t) ** self.gamma) * ce
        return tf.reduce_mean(focal_loss)


# =========================================================
# BUILD MODEL
# =========================================================
def build_model():

    base_model = EfficientNetB7(
        include_top=False,
        weights='imagenet',
        input_shape=(IMG_SIZE, IMG_SIZE, 3)
    )
    base_model.trainable = False

    inputs = layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3))

    x = data_augmentation(inputs)          # augment during training only
    x = base_model(x, training=False)

    # --- Classifier Head ---
    x = layers.GlobalAveragePooling2D()(x)
    x = layers.BatchNormalization()(x)
    x = layers.Dropout(0.5)(x)

    x = layers.Dense(1024, activation='swish')(x)
    x = layers.BatchNormalization()(x)
    x = layers.Dropout(0.4)(x)

    x = layers.Dense(512, activation='swish')(x)

    # Squeeze-and-Excitation attention
    se = layers.Dense(128, activation='relu')(x)
    se = layers.Dense(512, activation='sigmoid')(se)
    x  = layers.Multiply()([x, se])

    x = layers.BatchNormalization()(x)
    x = layers.Dropout(0.3)(x)

    outputs = layers.Dense(
        NUM_CLASSES, activation='softmax', dtype='float32'
    )(x)

    return Model(inputs, outputs), base_model


model, base_model = build_model()
print("\nMODEL CREATED SUCCESSFULLY")
model.summary()


# =========================================================
# LEARNING RATE SCHEDULE
# =========================================================
lr_schedule = tf.keras.optimizers.schedules.CosineDecayRestarts(
    initial_learning_rate=1e-3,
    first_decay_steps=1000,
    t_mul=2.0,
    m_mul=0.9,
    alpha=1e-6
)


# =========================================================
# COMPILE — PHASE 1 (frozen base, train head only)
# FIX [4]: No class_weight — oversampling already balanced
# =========================================================
model.compile(
    optimizer=tf.keras.optimizers.AdamW(
        learning_rate=lr_schedule,
        weight_decay=1e-5,
        clipnorm=1.0
    ),
    loss=FocalLoss(),
    metrics=['accuracy']
)

# =========================================================
# PHASE 1 CALLBACKS
# Separate from Phase 2 so the patience counter resets
# cleanly when fine-tuning begins.
# patience=10 is fine for head training (converges fast).
# =========================================================
callbacks_phase1 = [
    ModelCheckpoint(
        "best_efficientnetb7.keras",
        monitor='val_accuracy',
        save_best_only=True,
        verbose=1
    ),
    EarlyStopping(
        monitor='val_accuracy',
        patience=10,
        min_delta=1e-4,           # must improve by at least 0.01%
        restore_best_weights=True
    )
]


# =========================================================
# PHASE 1: TRAIN HEAD
# =========================================================
print("\nPhase 1 — Training classifier head (base frozen)...\n")

history = model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=HEAD_EPOCHS,
    callbacks=callbacks_phase1
)


# =========================================================
# PHASE 2: FINE-TUNE (unfreeze top 50 layers of base)
# =========================================================
print("\nPhase 2 — Fine-tuning top 50 layers of EfficientNetB7...\n")

base_model.trainable = True
for layer in base_model.layers[:-50]:
    layer.trainable = False

model.compile(
    optimizer=tf.keras.optimizers.AdamW(
        learning_rate=1e-5,
        weight_decay=1e-6,
        clipnorm=1.0
    ),
    loss=FocalLoss(),
    metrics=['accuracy']
)

# =========================================================
# PHASE 2 CALLBACKS
# Fresh EarlyStopping — patience counter starts from 0.
# patience=FINE_TUNE_EPOCHS means early stopping is
# effectively disabled for Phase 2: all 45 epochs will
# always run and the best weights are still restored at
# the end via restore_best_weights=True.
# ModelCheckpoint continues saving the overall best model
# across both phases (same file, save_best_only=True).
# =========================================================
callbacks_phase2 = [
    ModelCheckpoint(
        "best_efficientnetb7.keras",
        monitor='val_accuracy',
        save_best_only=True,
        verbose=1
    ),
    EarlyStopping(
        monitor='val_accuracy',
        patience=FINE_TUNE_EPOCHS,  # never fires — all 45 epochs run
        min_delta=1e-4,
        restore_best_weights=True
    )
]

history_fine = model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=FINE_TUNE_EPOCHS,
    callbacks=callbacks_phase2
)


# =========================================================
# TEST TIME AUGMENTATION (TTA) ON VALIDATION — optional
# =========================================================
print("\nRunning TTA on validation set...\n")

tta_steps   = 12
val_preds   = []

for _ in range(tta_steps):
    val_preds.append(model.predict(val_ds, verbose=0))

val_predictions = np.mean(val_preds, axis=0)
y_val_pred      = np.argmax(val_predictions, axis=1)

print("\n--- Validation Set Report ---")
print(classification_report(y_val, y_val_pred))
print("Confusion Matrix:\n", confusion_matrix(y_val, y_val_pred))


# =========================================================
# FINAL EVALUATION ON HELD-OUT TEST SET
#
# This is the only honest accuracy number.
# The model has NEVER seen these images during training
# or hyperparameter tuning.
# =========================================================
print("\n" + "="*55)
print("FINAL EVALUATION ON HELD-OUT TEST SET")
print("="*55 + "\n")

# TTA on test set
test_preds = []
for _ in range(tta_steps):
    test_preds.append(model.predict(test_ds, verbose=0))

test_predictions = np.mean(test_preds, axis=0)
y_test_pred      = np.argmax(test_predictions, axis=1)

# Standard metric evaluation
test_loss, test_accuracy = model.evaluate(test_ds, verbose=1)

print(f"\nTest Loss    : {test_loss:.4f}")
print(f"Test Accuracy: {test_accuracy * 100:.2f}%")

print("\n--- Test Set Classification Report ---")
print(classification_report(y_test, y_test_pred))

print("Test Confusion Matrix:\n")
print(confusion_matrix(y_test, y_test_pred))


# =========================================================
# GRAPH VISUALIZATION
# =========================================================

# --- Merge Phase 1 + Phase 2 histories ---
all_train_acc  = history.history['accuracy']     + history_fine.history['accuracy']
all_val_acc    = history.history['val_accuracy'] + history_fine.history['val_accuracy']
all_train_loss = history.history['loss']         + history_fine.history['loss']
all_val_loss   = history.history['val_loss']     + history_fine.history['val_loss']

Epochs         = range(1, len(all_train_acc) + 1)
phase_boundary = len(history.history['accuracy'])

index_best_acc  = int(np.argmax(all_val_acc))
index_best_loss = int(np.argmin(all_val_loss))

plt.figure(figsize=(20, 6))
plt.style.use('fivethirtyeight')

# ---- Accuracy -------------------------------------------
plt.subplot(1, 2, 1)
plt.plot(Epochs, all_train_acc, 'r', label='Training Accuracy')
plt.plot(Epochs, all_val_acc,   'g', label='Validation Accuracy')
plt.scatter(
    index_best_acc + 1, all_val_acc[index_best_acc],
    s=150, c='blue', zorder=5,
    label=f'Best epoch = {index_best_acc + 1}'
)
plt.axvline(
    x=phase_boundary + 0.5,
    color='gray', linestyle='--', alpha=0.6,
    label='Fine-tune start'
)
plt.title('Training and Validation Accuracy')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.legend()
plt.grid(True)

# ---- Loss -----------------------------------------------
plt.subplot(1, 2, 2)
plt.plot(Epochs, all_train_loss, 'r', label='Training Loss')
plt.plot(Epochs, all_val_loss,   'g', label='Validation Loss')
plt.scatter(
    index_best_loss + 1, all_val_loss[index_best_loss],
    s=150, c='blue', zorder=5,
    label=f'Best epoch = {index_best_loss + 1}'
)
plt.axvline(
    x=phase_boundary + 0.5,
    color='gray', linestyle='--', alpha=0.6,
    label='Fine-tune start'
)
plt.title('Training and Validation Loss')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.legend()
plt.grid(True)

plt.suptitle('Model Training Metrics Over Epochs', fontsize=16)
plt.tight_layout()
plt.savefig('training_metrics.png', dpi=150, bbox_inches='tight')
plt.show()
print("\nPlot saved as training_metrics.png")


# =========================================================
# SAVE MODEL
# =========================================================
model.save("efficientnetb7_dr_final.keras")
print("\nMODEL SAVED SUCCESSFULLY")


# =========================================================
# MEMORY CLEANUP
# =========================================================
gc.collect()
