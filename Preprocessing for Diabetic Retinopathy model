        path = row["image_path"]

        img = cv2.imread(path)

        if img is None:
            continue

        img = cv2.cvtColor(
            img,
            cv2.COLOR_BGR2RGB
        )

        # ================= SIZE CHECK =================
        if not is_valid_size(img):

            removed_small += 1
            continue

        # ================= BLUR CHECK =================
        if is_blurry(img):

            removed_blurry += 1
            continue

        # ================= OVEREXPOSURE CHECK =================
        if is_overexposed(img):

            removed_overexposed += 1
            continue

        # ================= UNDEREXPOSURE CHECK =================
        if is_underexposed(img):

            removed_underexposed += 1
            continue

        # ================= LOW INFORMATION CHECK =================
        if not has_enough_information(img):

            removed_low_info += 1
            continue

        # ================= DUPLICATE IMAGE CHECK =================
        small = cv2.resize(
            img,
            (32, 32)
        )

        image_hash = hash(
            small.tobytes()
        )

        if image_hash in hashes:

            removed_duplicate += 1
            continue

        hashes.add(image_hash)

        cleaned_rows.append(row)

    except:

        continue

