# ========================= BLUR DETECTION =========================
def is_blurry(img, threshold=35):

    gray = cv2.cvtColor(
        img,
        cv2.COLOR_RGB2GRAY
    )

    variance = cv2.Laplacian(
        gray,
        cv2.CV_64F
    ).var()

    return variance < threshold

# ========================= OVEREXPOSURE CHECK =========================
def is_overexposed(img, threshold=245):

    gray = cv2.cvtColor(
        img,
        cv2.COLOR_RGB2GRAY
    )

    bright_ratio = np.mean(
        gray > threshold
    )

    return bright_ratio > 0.35

# ========================= UNDEREXPOSURE CHECK =========================
def is_underexposed(img, threshold=15):

    gray = cv2.cvtColor(
        img,
        cv2.COLOR_RGB2GRAY
    )

    dark_ratio = np.mean(
        gray < threshold
    )

    return dark_ratio > 0.50

# ========================= LOW INFORMATION CHECK =========================
def has_enough_information(img):

    gray = cv2.cvtColor(
        img,
        cv2.COLOR_RGB2GRAY
    )

    return np.std(gray) > 18

# ========================= IMAGE SIZE CHECK =========================
def is_valid_size(img):

    h, w = img.shape[:2]

    return h >= 150 and w >= 150

# ========================= CLEANING LOOP =========================
for _, row in tqdm(
    df.iterrows(),
    total=len(df)
):

