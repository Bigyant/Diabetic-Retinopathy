# ========================= RETINA CROP FUNCTION =========================
def crop_black_background(img):

    gray = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)

    _, thresh = cv2.threshold(gray, 10, 255, cv2.THRESH_BINARY)

    coords = cv2.findNonZero(thresh)

    if coords is not None:

        x, y, w, h = cv2.boundingRect(coords)

        img = img[y:y+h, x:x+w]

    return img

# ========================= PREPROCESS FUNCTION =========================

def preprocess_retinal_image(path, size=IMG_SIZE):

    img = cv2.imread(path)

    if img is None:
        raise ValueError(f"Cannot Read Image: {path}")

    # ================= BGR → RGB =================
    img = cv2.cvtColor(
        img,
        cv2.COLOR_BGR2RGB
    )

    # ================= CROP BLACK BACKGROUND =================
    img = crop_black_background(img)

    # ================= RESIZE =================
    img = cv2.resize(
        img,
        (size, size)
    )

    # ================= GREEN CHANNEL EXTRACTION =================
    # Green channel contains most retinal lesion details
    green_channel = img[:, :, 1]

    # ================= CLAHE ENHANCEMENT =================
    clahe = cv2.createCLAHE(

        clipLimit=3.0,

        tileGridSize=(8, 8)
    )

    enhanced = clahe.apply(green_channel)

    # ================= GAUSSIAN BLUR =================
    blurred = cv2.GaussianBlur(
        enhanced,
        (5, 5),
        0
    )

    # ================= SHARPENING =================
    sharpened = cv2.addWeighted(
        enhanced,
        1.5,
        blurred,
        -0.5,
        0
    )

    # ================= NORMALIZATION =================
    normalized = cv2.normalize(
        sharpened,
        None,
        0,
        255,
        cv2.NORM_MINMAX
    )

    # ================= CONVERT BACK TO RGB =================
    img = cv2.merge([
        normalized,
        normalized,
        normalized
    ])

    return img.astype(np.uint8)
